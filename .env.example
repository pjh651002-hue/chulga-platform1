# Vercel 프로젝트 설정에 등록할 환경변수 예시입니다.
# 이 파일에 실제 키를 적지 마십시오. .env 는 .gitignore 에 포함되어 있습니다.

# ── 출가상담 응답 (api/ask.js) ────────────────────────────────
ANTHROPIC_API_KEY=여기에_키를_넣지_말고_Vercel_설정에_등록하십시오
ANSWER_MODEL=claude-sonnet-5
ALLOWED_ORIGIN=https://배포도메인

# ── 익명 퍼널 수집 (api/track.js, api/stats.js) ───────────────
# 아래 셋을 비워 두면 수집이 꺼진 채로 앱이 정상 동작합니다.
# 운영자 화면은 예시 수치를 그대로 보여줍니다.
#
# SUPABASE_SERVICE_ROLE_KEY 는 모든 권한을 가진 키입니다.
# 절대 브라우저로 내려보내지 마시고 Vercel 설정에만 두십시오.
SUPABASE_URL=https://프로젝트id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=서비스_롤_키
# 운영자 화면에서 실제 집계를 볼 때 입력하는 키입니다. 길고 무작위하게 정하십시오.
STATS_TOKEN=충분히_긴_무작위_문자열
